# ============================================
# AI-SKILL — Environment Variables
# ============================================
# Copy this file to .env and fill in actual values:
#   cp .env.example .env
# ============================================

# --- Application ---
APP_NAME="AI-SKILL"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# --- PostgreSQL ---
POSTGRES_USER=skill_user
POSTGRES_PASSWORD=skill_pass
POSTGRES_DB=skill_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://skill_user:skill_pass@postgres:5432/skill_db"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# --- Redis ---
REDIS_URL="redis://redis:6379/0"
REDIS_POOL_SIZE=50

# --- Qdrant (Vector Database) ---
QDRANT_URL="http://qdrant:6333"
QDRANT_API_KEY=

# --- JWT Authentication ---
# Generate a strong key: openssl rand -hex 32
JWT_SECRET_KEY="change-this-to-a-random-secret-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS="http://localhost:3000"

# --- Frontend ---
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_APP_NAME="AI-SKILL"

# --- Sentry (Error Monitoring) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# --- Storage ---
# Options: local, s3
STORAGE_TYPE="local"
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION="us-east-1"
S3_ENDPOINT_URL=

# --- Embedding Model ---
EMBEDDING_MODEL="sentence-transformers/all-mpnet-base-v2"
EMBEDDING_DIMENSION=768

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
# Options: json, console
LOG_FORMAT="json"

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW=60

# --- API ---
API_PREFIX="/api/v1"

# --- Celery ---
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"