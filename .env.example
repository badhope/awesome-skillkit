# ============================================
# AI-SKILL — Environment Variables
# ============================================
# Copy this file to .env and fill in actual values:
#   cp .env.example .env
#
# REQUIRED for production:
#   - JWT_SECRET_KEY   (>=32 chars; generate with `openssl rand -hex 32`)
#   - ADMIN_PASSWORD   (>=12 chars; used for first superuser bootstrap)
# ============================================

# --- Application ---
APP_NAME="AI-SKILL"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# --- PostgreSQL ---
# Generate a strong POSTGRES_PASSWORD with: openssl rand -base64 18
POSTGRES_USER=skill_user
POSTGRES_PASSWORD=change-this-to-a-strong-db-password
POSTGRES_DB=skill_db
POSTGRES_PORT=5432
# DSN is composed from POSTGRES_USER/POSTGRES_PASSWORD to keep the file free
# of inline credentials. Override DATABASE_URL only if you run Postgres on a
# different host.
DATABASE_URL="postgresql+asyncpg://skill_user:change-this-to-a-strong-db-password@postgres:5432/skill_db"
DATABASE_POOL_SIZE=20
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# --- Redis ---
REDIS_URL="redis://redis:6379/0"
REDIS_POOL_SIZE=50

# --- Qdrant (Vector Database) ---
QDRANT_URL="http://qdrant:6333"
QDRANT_API_KEY=

# --- JWT Authentication ---
# Generate with: openssl rand -hex 32
# REQUIRED in production. The application will refuse to start (production
# mode) if this is missing, shorter than 32 chars, or matches a known
# weak default. In DEBUG mode an ephemeral random key is generated and
# printed in the logs (invalidated on every restart).
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Admin bootstrap ---
# Used by the optional first-run admin seeder (app.core.seed) and by
# `python -m app.scripts.create_admin`. The application refuses to create a
# default admin in production if this is unset.
# Generate a strong ADMIN_PASSWORD with: openssl rand -base64 18
ADMIN_EMAIL="admin@ai-skill.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_FULL_NAME="System Administrator"

# --- CORS ---
# Comma-separated list of allowed origins. Use your real frontend domain
# in production; wildcard is NOT supported when allow_credentials=true.
BACKEND_CORS_ORIGINS="http://localhost:3000"

# --- Frontend ---
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_APP_NAME="AI-SKILL"

# --- Sentry (Error Monitoring) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# --- Storage ---
# Options: local, s3
STORAGE_TYPE="local"
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION="us-east-1"
S3_ENDPOINT_URL=

# --- Embedding Model ---
EMBEDDING_MODEL="sentence-transformers/all-mpnet-base-v2"
EMBEDDING_DIMENSION=768

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
# Options: json, console
LOG_FORMAT="json"

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW=60

# --- API ---
API_PREFIX="/api/v1"

# --- Celery ---
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"
