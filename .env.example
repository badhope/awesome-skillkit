# ============================================
# AI-SKILL — Compose / Full-Stack Environment Variables
# ============================================
# Copy this file to `.env` (project root) and fill in actual values:
#   cp .env.example .env
#
# Scope of this file:
#   docker-compose.yml reads it via `env_file: .env` for the postgres and
#   backend services, and inline-substitutes a few values into other
#   services (frontend). So this file is the deployment / compose-facing
#   template.
#
# For the full list of backend Settings (and the bare-metal dev defaults
# for each), see `backend/.env.example`. To override an extra backend
# setting in compose, add it here — the backend container will read it.
#
# REQUIRED for production:
#   - JWT_SECRET_KEY   (>=32 chars; generate with `openssl rand -hex 32`)
#   - ADMIN_PASSWORD   (>=12 chars; used for first superuser bootstrap)
#   - POSTGRES_PASSWORD (strong; generate with `openssl rand -base64 18`)
# ============================================

# --- PostgreSQL (consumed by the postgres service in compose) ---
# Generate a strong POSTGRES_PASSWORD with: openssl rand -base64 18
POSTGRES_USER=skill_user
POSTGRES_PASSWORD=change-this-to-a-strong-db-password
POSTGRES_DB=skill_db

# --- Redis / Qdrant connection strings (compose-internal hostnames) ---
# The compose file wires these into the backend service automatically.
# Override here only if you point the backend at a remote Redis / Qdrant.
REDIS_URL="redis://redis:6379/0"
QDRANT_URL="http://qdrant:6333"
QDRANT_API_KEY=

# --- JWT / Admin (consumed by the backend container) ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL="admin@ai-skill.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_FULL_NAME="System Administrator"

# --- CORS ---
# Comma-separated list of allowed origins. Wildcard is NOT supported
# because the API sets `allow_credentials=true`.
BACKEND_CORS_ORIGINS="http://localhost:3000"

# --- Frontend (consumed by the frontend service in compose) ---
# The frontend is Next.js 15 (App Router); env vars exposed to the
# browser MUST be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="AI-SKILL"

# --- Celery (optional, only if you run the worker stack) ---
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"
