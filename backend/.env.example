# ============================================
# Modern Skill Library - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# --- 应用基础配置 ---
APP_NAME="Modern Skill Library"
APP_VERSION="1.0.0"
DEBUG=false
API_PREFIX="/api/v1"

# --- 数据库配置 (PostgreSQL + asyncpg) ---
DATABASE_URL="postgresql+asyncpg://user:pass@localhost:5432/skill_db"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# --- Redis 配置 ---
REDIS_URL="redis://localhost:6379/0"
REDIS_POOL_SIZE=50

# --- Qdrant 向量数据库配置 ---
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=

# --- JWT 认证配置 ---
# 生产环境务必使用 openssl rand -hex 32 生成强密钥
JWT_SECRET_KEY="your-super-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS 跨域配置 ---
# 多个域名用逗号分隔，如: http://localhost:3000,https://app.example.com
BACKEND_CORS_ORIGINS="http://localhost:3000"

# --- Sentry 错误监控配置 ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# --- 文件存储配置 ---
# 可选值: local, s3
STORAGE_TYPE="local"
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION="us-east-1"
S3_ENDPOINT_URL=

# --- 向量嵌入模型配置 ---
EMBEDDING_MODEL="sentence-transformers/all-mpnet-base-v2"
EMBEDDING_DIMENSION=768

# --- 日志配置 ---
# 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
# 可选值: json, console
LOG_FORMAT="json"

# --- 限流配置 ---
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW=60