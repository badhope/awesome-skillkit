# ============================================
# AI-SKILL - Environment Configuration
# ============================================
# Copy this file to .env and fill in actual values
# cp .env.example .env
#
# REQUIRED for production:
#   - JWT_SECRET_KEY   (>=32 chars; generate with `openssl rand -hex 32`)
#   - ADMIN_PASSWORD   (>=12 chars; used for first superuser bootstrap)
# ============================================

# --- Application ---
APP_NAME="AI-SKILL"
APP_VERSION="1.0.0"
DEBUG=false
API_PREFIX="/api/v1"

# --- Database (PostgreSQL + asyncpg) ---
# In production, override DATABASE_URL via the POSTGRES_USER / POSTGRES_PASSWORD
# environment variables. The values below are placeholders only.
DATABASE_URL="postgresql+asyncpg://REPLACE_ME:REPLACE_ME@localhost:5432/skill_db"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# --- Redis ---
REDIS_URL="redis://localhost:6379/0"
REDIS_POOL_SIZE=50

# --- Qdrant Vector Database ---
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=

# --- JWT Authentication ---
# Generate with: openssl rand -hex 32
# REQUIRED in production. The application will refuse to start (production
# mode) if this is missing, shorter than 32 chars, or matches a known
# weak default. In DEBUG mode an ephemeral random key is generated and
# printed in the logs (invalidated on every restart).
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Admin bootstrap ---
ADMIN_EMAIL="admin@ai-skill.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_FULL_NAME="System Administrator"

# --- CORS ---
# Multiple domains separated by commas, e.g.: http://localhost:3000,https://app.example.com
BACKEND_CORS_ORIGINS="http://localhost:3000"

# --- Sentry Error Monitoring ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# --- File Storage ---
# Options: local, s3
STORAGE_TYPE="local"
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION="us-east-1"
S3_ENDPOINT_URL=

# --- Vector Embedding Model ---
EMBEDDING_MODEL="sentence-transformers/all-mpnet-base-v2"
EMBEDDING_DIMENSION=768

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
# Options: json, console
LOG_FORMAT="json"

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW=60
